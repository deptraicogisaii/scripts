local HeadOff = Vector3.new(0, 0.5, 0)
local LegOff = Vector3.new(0, 3, 0)

local function createESP(v)
    if v == lplr then
        return
    end
    
    local BoxOutline = Drawing.new("Square")
    BoxOutline.Visible = false
    BoxOutline.Color = Color3.new(0, 0, 0)
    BoxOutline.Thickness = 3
    BoxOutline.Transparency = 1
    BoxOutline.Filled = false

    local Box = Drawing.new("Square")
    Box.Visible = false
    Box.Color = Color3.new(1, 1, 1)
    Box.Thickness = 1
    Box.Transparency = 1
    Box.Filled = false

    local HealthBarOutline = Drawing.new("Line")
    HealthBarOutline.Thickness = 3
    HealthBarOutline.Color = Color3.new(0, 0, 0)
    HealthBarOutline.Visible = false

    local HealthBar = Drawing.new("Line")
    HealthBar.Thickness = 2
    HealthBar.Visible = false

    local ToolText = Drawing.new("Text")
    ToolText.Visible = false
    ToolText.Size = 12
    ToolText.Center = true
    ToolText.Outline = true
    ToolText.OutlineColor = Color3.new(0, 0, 0)
    ToolText.Color = Color3.new(1, 1, 1)

    local NameText = Drawing.new("Text")
    NameText.Visible = false
    NameText.Size = 13
    NameText.Center = true
    NameText.Outline = true
    NameText.OutlineColor = Color3.new(0, 0, 0)
    NameText.Color = Color3.new(1, 1, 1)

    local Tracer = Drawing.new("Line")
    Tracer.Visible = false
    Tracer.Color = Color3.new(1, 1, 1)
    Tracer.Thickness = 1
    Tracer.Transparency = 1

    local function updateESP()
        game:GetService("RunService").RenderStepped:Connect(function()
            if v == lplr then
                Box.Visible = false
                BoxOutline.Visible = false
                HealthBarOutline.Visible = false
                HealthBar.Visible = false
                ToolText.Visible = false
                NameText.Visible = false
                Tracer.Visible = false
                return
            end
            
            if v.Character and v.Character:FindFirstChild("Humanoid") and v.Character:FindFirstChild("HumanoidRootPart") and v.Character.Humanoid.Health > 0 then
                local Vector, onScreen = camera:worldToViewportPoint(v.Character.HumanoidRootPart.Position)

                local RootPart = v.Character.HumanoidRootPart
                local Head = v.Character.Head
                local RootPosition, RootVis = worldToViewportPoint(CurrentCamera, RootPart.Position)
                local HeadPosition = worldToViewportPoint(CurrentCamera, Head.Position + HeadOff)
                local LegPosition = worldToViewportPoint(CurrentCamera, RootPart.Position - LegOff)

                if onScreen then
                    local boxWidth = 1000 / RootPosition.Z
                    local boxHeight = HeadPosition.Y - LegPosition.Y
                    local boxX = RootPosition.X - boxWidth / 2
                    local boxY = RootPosition.Y - boxHeight / 2

                    if boxesEnabled then
                        BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                        BoxOutline.Position = Vector2.new(boxX, boxY)
                        BoxOutline.Visible = true

                        Box.Size = Vector2.new(boxWidth, boxHeight)
                        Box.Position = Vector2.new(boxX, boxY)
                        Box.Visible = true
                    else
                        Box.Visible = false
                        BoxOutline.Visible = false
                    end

                    if healthBarEnabled then
                        HealthBarOutline.From = Vector2.new(boxX - 7, boxY)
                        HealthBarOutline.To = Vector2.new(boxX - 7, boxY + boxHeight)
                        HealthBarOutline.Visible = true

                        local healthRatio = v.Character.Humanoid.Health / v.Character.Humanoid.MaxHealth
                        HealthBar.From = Vector2.new(boxX - 7, boxY + boxHeight)
                        HealthBar.To = Vector2.new(boxX - 7, boxY + boxHeight - (boxHeight * healthRatio))
                        HealthBar.Color = Color3.fromRGB(255 * (1 - healthRatio), 255 * healthRatio, 0)
                        HealthBar.Visible = true
                    else
                        HealthBarOutline.Visible = false
                        HealthBar.Visible = false
                    end

                    if displayNameEnabled then
                        local displayName = v.DisplayName
                        if displayNameEnabled then
                            NameText.Text = v.DisplayName
                        end
                        NameText.Position = Vector2.new(RootPosition.X, HeadPosition.Y - 25)
                        NameText.Visible = true
                    else
                        NameText.Visible = false
                    end
                    
                    if toolEspEnabled then
                        local toolName = "None"
                        if v.Character:FindFirstChildOfClass("Tool") then
                            toolName = v.Character:FindFirstChildOfClass("Tool").Name
                        end
                        
                        ToolText.Text = "" .. toolName
                        ToolText.Position = Vector2.new(RootPosition.X, LegPosition.Y + 15)
                        ToolText.Visible = true
                    else
                        ToolText.Visible = false
                    end

                    if tracersEnabled then
                        Tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        Tracer.To = Vector2.new(Vector.X, Vector.Y)

                        if _G.TeamCheck and v.TeamColor == lplr.TeamColor then
                            Tracer.Visible = false
                        else
                            Tracer.Visible = true
                        end
                    else
                        Tracer.Visible = false
                    end
                else
                    Box.Visible = false
                    BoxOutline.Visible = false
                    HealthBarOutline.Visible = false
                    HealthBar.Visible = false
                    ToolText.Visible = false
                    NameText.Visible = false
                    Tracer.Visible = false
                end
            else
                Box.Visible = false
                BoxOutline.Visible = false
                HealthBarOutline.Visible = false
                HealthBar.Visible = false
                ToolText.Visible = false
                NameText.Visible = false
                Tracer.Visible = false
            end
        end)
    end
    coroutine.wrap(updateESP)()
end


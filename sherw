                            getgenv().khencc.hitbox_expander.Size
                        )
                        humanoidRootPart.Transparency = getgenv().khencc.hitbox_expander.Transparency
                        humanoidRootPart.Color = getgenv().khencc.hitbox_expander.Color
                        humanoidRootPart.Material = Enum.Material.ForceField
                        humanoidRootPart.CanCollide = false
                    end)
                else
                    pcall(function()
                        humanoidRootPart.Size = Vector3.new(2, 2, 1)
                        humanoidRootPart.Transparency = 1
                        humanoidRootPart.Material = Enum.Material.Plastic
                    end)
                end
            end
        end
    end)

    local function createFloatingText(character)
        local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if torso then
            if getgenv().khencc.Watermark.Enabled and not character:FindFirstChild("khenccWM") then
                local billboardGui = Instance.new("BillboardGui")
                billboardGui.Size = UDim2.new(0, 24, 0, 24)
                billboardGui.Adornee = torso
                billboardGui.AlwaysOnTop = true
                billboardGui.Name = "khenccWM"
                billboardGui.Parent = character

                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = getgenv().khencc.Watermark.Text
                textLabel.TextSize = getgenv().khencc.Watermark.TextSize
                textLabel.TextColor3 = Color3.fromRGB(209, 206, 255)
                textLabel.Font = getgenv().khencc.Watermark.Font
                textLabel.TextStrokeTransparency = getgenv().khencc.Watermark.TextTransparency
                textLabel.Parent = billboardGui
            elseif not getgenv().khencc.Watermark.Enabled then
                local old = character:FindFirstChild("khenccWM")
                if old then old:Destroy() end
            end
        end
    end

    game:GetService("RunService").Heartbeat:Connect(function()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                createFloatingText(player.Character)
            end
        end
    end)
end)

